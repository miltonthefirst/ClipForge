{
  "name": "clipforge-firebase-tests",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Emulator-backed tests for firestore.rules and storage.rules",
  "scripts": {
    "test": "firebase emulators:exec --project demo-clipforge --only auth,firestore,storage \"vitest run\"",
    "test:watch": "firebase emulators:exec --project demo-clipforge --only auth,firestore,storage \"vitest\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.2.0",
    "firebase-tools": "^15.25.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
