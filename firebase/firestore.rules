rules_version = '2';

// ClipForge Firestore security rules.
//
// These rules are production code. Every change needs a corresponding emulator
// test in the same PR (docs/PLAN.md Phase 1, "Risks").
//
// ─────────────────────────────────────────────────────────────────────────────
// A note on what these rules can and cannot do.
//
// The worker authenticates with the Admin SDK, which BYPASSES these rules
// entirely. So nothing here constrains the worker — it is the PWA's boundary,
// not the worker's. That asymmetry is deliberate and is why ClipForge lives in
// its own Firebase project rather than sharing one: rules could not have
// protected a neighbouring app's data from a worker bug.
// See docs/adr/0004-dedicated-firebase-project.md.
//
// The design rule that follows: the PWA may CREATE work and REVIEW results, but
// may never write pipeline state. Anything the worker owns is read-only here,
// so a compromised or buggy client cannot forge a COMPLETED job, invent a
// candidate, or rewrite an event log.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ── Access is approval, not merely authentication ────────────────────────
    //
    // Registration is open: anyone with the URL can create an account. What a
    // new account can *see* is nothing at all until an admin approves it, so a
    // stray sign-up is an inert row rather than a foothold.
    //
    // This costs one document read per rule evaluation. At this project's scale
    // that is a rounding error against the free tier's daily allowance, and the
    // alternative — custom claims on the token — would put approval on a delay
    // measured in token lifetimes and route it through the worker. Approval
    // should take effect on the next request, not the next hour.
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return signedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && profile().status == 'APPROVED';
    }

    function isAdmin() {
      return isApproved() && profile().role == 'ADMIN';
    }

    // ── One workspace, not one per person ────────────────────────────────────
    //
    // ClipForge is a single shared system: one machine, one clip library, a
    // small group of trusted people. Access is therefore decided by *approval*,
    // not by ownership — an approved member sees and acts on everything.
    //
    // It was built the other way first, with every collection scoped to the
    // uid that created it, and that turned out to describe something nobody
    // wanted: two private workspaces that happened to share a worker. A job
    // submitted from a phone was invisible on the desktop next to it, and a
    // clip rendered by one account could not be reviewed by the other.
    //
    // `uid` stays on every document, and still has a job — it records who
    // submitted the work, so the audit trail survives. It is deliberately no
    // longer the access control.
    //
    // The consequence, stated plainly because it is the whole security model:
    // registration is open, so *approving* an account is what hands over the
    // entire library. Approval is the gate. There is nothing behind it.
    //
    // What has NOT changed is the other half of the design — the PWA may create
    // work and review results, and may never write pipeline state. Sharing
    // widens who can read and decide; it does not let a client forge a
    // COMPLETED job, invent a candidate, or rewrite an event log.

    // The document being written must be stamped with the caller's own uid.
    // Kept even though reads are shared: attribution is only worth having if a
    // client cannot file work under somebody else's name.
    function ownsIncoming() {
      return isApproved() && request.resource.data.uid == request.auth.uid;
    }

    // Which fields an update actually touched.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Accounts ─────────────────────────────────────────────────────────────
    //
    // The one collection that cannot gate on approval, because it is where
    // approval is recorded. A signed-in user may always read their own row —
    // otherwise a pending account could not be told it is pending.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Register yourself, as yourself, with no say in your own access. Role
      // and status are dictated here rather than trusted from the client: a
      // sign-up that could choose 'ADMIN'/'APPROVED' would make the whole gate
      // decorative.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'MEMBER'
                    && request.resource.data.status == 'PENDING'
                    && request.resource.data.decidedAt == null
                    && request.resource.data.decidedBy == null;

      // Your own profile: the cosmetic fields only.
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && changed().hasOnly(['displayName', 'photoUrl']);

      // An admin decides access. They may not change their own, which stops the
      // last admin from locking everyone out — including themselves — with one
      // mistaken tap.
      allow update: if isAdmin()
                    && request.auth.uid != uid
                    && changed().hasOnly(['role', 'status', 'decidedAt', 'decidedBy'])
                    && request.resource.data.status in ['PENDING', 'APPROVED', 'REJECTED', 'DISABLED']
                    && request.resource.data.role in ['ADMIN', 'MEMBER']
                    && request.resource.data.decidedBy == request.auth.uid;

      allow delete: if false;
    }

    // ── Workers ──────────────────────────────────────────────────────────────
    // Heartbeats are written by the worker through the Admin SDK. The PWA reads
    // them to show whether a worker is online and why a job might be stalled.
    //
    // This was the first rule to be scoped by approval rather than ownership,
    // and it was scoped that way because the ownership version was not merely
    // wrong but inert: the worker announces itself with a placeholder uid
    // rather than a Firebase account, so it matched nobody and the heartbeat
    // was unreadable by every client. A job stuck at QUEUED then looked
    // identical to a job nobody had explained.
    //
    // `heartbeat.uid` records who runs the worker, not who may look at it.
    match /workers/{workerId} {
      allow read: if isApproved();
      allow write: if false;
    }

    // ── Agents ───────────────────────────────────────────────────────────────
    //
    // The one place a client may influence what runs on the machine, and the
    // exception is narrow on purpose.
    //
    // ClipForge has no server-side executor: a job stays QUEUED until a process
    // on the worker machine claims it (docs/adr/0006-lease-based-job-claiming.md).
    // Before this collection existed, the only things that could start that
    // process were a terminal and the desktop shell — so a job submitted from a
    // phone waited for somebody to walk to the PC. The agent watches this
    // document and does what it says.
    // See docs/adr/0012-machine-agent.md.
    //
    // `desired` is a WISH, not a state. The client may say what it wants and
    // nothing else; every field describing what is actually happening — the run
    // state, the pid, the exit code, the log — is written by the agent through
    // the Admin SDK and is read-only here. That keeps the rule this file is
    // built on intact: the PWA may create work and review results, and may never
    // write pipeline state.
    //
    // Creation is refused, and that is load-bearing rather than tidy. The agent
    // creates its own document on first run, so "no document" means *no agent
    // has ever run on that machine* — which is a different problem from "the
    // agent is not reporting right now", and a client that could conjure a row
    // would erase the difference. A phone would then offer a Start button for a
    // machine that has never had anything listening.
    match /agents/{agentId} {
      allow read: if isApproved();
      allow create, delete: if false;

      // `requestedAt` is required on every write, and is what makes pressing
      // Start on a worker that is already wanted a distinguishable event: that
      // press is how a person clears an agent that has given up, and a rule that
      // let the timestamp be omitted would make the recovery silently depend on
      // the value happening to change.
      //
      // `requestedBy` is pinned to the caller for the same reason `uid` is on a
      // job: a shared workspace can afford anyone starting the worker, and
      // cannot afford not knowing who did.
      allow update: if isApproved()
                    && changed().hasOnly(['desired', 'requestedBy', 'requestedAt'])
                    && request.resource.data.desired in ['RUNNING', 'STOPPED']
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.requestedAt is string;
    }

    // ── The publish gate, client half ────────────────────────────────────────
    //
    // The worker enforces this too, in clipforge/publish/gate.py. The
    // duplication is deliberate and neither copy is redundant: the worker uses
    // the Admin SDK, which bypasses these rules entirely, so rules alone would
    // protect nothing on the path that actually uploads. Conversely a rule is
    // the only thing that stops a client enqueueing publish work at all.
    // Phase 8 exit criterion 2 requires both, tested independently.
    //
    // A rights attestation used to be required here as well. It was removed at
    // the operator's request; what it recorded was a judgement only they could
    // make, and it was never a check this rule could actually perform. What is
    // left is the condition that was always doing the work: somebody watched
    // this clip and approved it.
    //
    // Note what is *not* checked: who owns the clip. In a shared workspace any
    // approved member may publish anything the workspace has approved. The job
    // still records who submitted it, which is the question a rule can answer.

    function clipOf(clipId) {
      return get(/databases/$(database)/documents/clips/$(clipId)).data;
    }

    function publishable(clipId) {
      return clipOf(clipId).review == 'APPROVED';
    }

    // What a MUSIC job may ask for. Validated because these values reach
    // ffmpeg and yt-dlp on the worker, and because a job that cannot possibly
    // succeed should fail here rather than after a download.
    function musicOptionsOk() {
      let options = request.resource.data.get('musicOptions', null);
      return options != null
             && options.keys().hasOnly(
                  ['source', 'mode', 'captions', 'gainDb', 'alignToBeat'])
             && options.source is string
             && options.source.size() > 0
             && options.source.size() <= 2048
             && options.mode in ['BED', 'REPLACE']
             && options.captions in ['KEEP', 'REMOVE']
             && (options.get('gainDb', null) == null
                 || (options.gainDb is number && options.gainDb >= -40 && options.gainDb <= 12))
             && (options.get('alignToBeat', null) == null || options.alignToBeat is bool);
    }

    // What a REMAKE job may ask for. Validated for the same reason the music
    // options are: these numbers reach ffmpeg filter expressions and a speech
    // synthesiser on the worker, and a request that cannot possibly succeed
    // should be refused here rather than after a re-render.
    //
    // Every field is optional. A remake is usually one complaint — "it loses
    // the ball", "put it in Spanish" — and demanding a fully-populated object
    // for a single correction would be the interface failing to do its job.
    function framingOk(framing) {
      return framing == null
             || (
                  framing.keys().hasOnly(
                    ['mode', 'crop', 'keyframes', 'fill', 'zoom', 'offsetYPct',
                     'smoothingSec', 'maxPanPctPerSec'])
                  && framing.mode in ['AS_RENDERED', 'FIT', 'PAN', 'TRACK']
                  && (framing.get('crop', null) == null
                      || framing.crop in ['centre', 'left', 'right'])
                  && (framing.get('fill', null) == null || framing.fill in ['BLUR', 'SOLID'])
                  && (framing.get('zoom', null) == null
                      || (framing.zoom is number && framing.zoom >= 1 && framing.zoom <= 2))
                  && (framing.get('offsetYPct', null) == null
                      || (framing.offsetYPct is number
                          && framing.offsetYPct >= -50 && framing.offsetYPct <= 50))
                  && (framing.get('smoothingSec', null) == null
                      || (framing.smoothingSec is number
                          && framing.smoothingSec >= 0 && framing.smoothingSec <= 10))
                  && (framing.get('maxPanPctPerSec', null) == null
                      || (framing.maxPanPctPerSec is number
                          && framing.maxPanPctPerSec >= 0 && framing.maxPanPctPerSec <= 100))
                  // Capped rather than merely typed: keyframes become one
                  // nested ffmpeg expression, and an unbounded list is an
                  // unbounded expression. Sixty points is a keyframe a second
                  // on a minute-long clip, which is far more than a person sets
                  // by hand and more than the tracker ever emits.
                  && (framing.get('keyframes', null) == null
                      || (framing.keyframes is list && framing.keyframes.size() <= 60))
                );
    }

    function voiceOk(voice) {
      return voice == null
             || (
                  voice.keys().hasOnly(
                    ['mode', 'voice', 'language', 'translate', 'script', 'speed',
                     'gainDb', 'duckDb', 'captions'])
                  && voice.mode in ['REPLACE', 'BED']
                  && voice.voice is string
                  && voice.voice.size() > 0
                  && voice.voice.size() <= 64
                  && voice.language is string
                  && voice.language.size() >= 2
                  && voice.language.size() <= 16
                  && (voice.get('translate', null) == null || voice.translate is bool)
                  && (voice.get('script', null) == null
                      || (voice.script is string && voice.script.size() <= 4000))
                  && (voice.get('speed', null) == null
                      || (voice.speed is number && voice.speed >= 0.5 && voice.speed <= 2))
                  && (voice.get('gainDb', null) == null
                      || (voice.gainDb is number && voice.gainDb >= -40 && voice.gainDb <= 12))
                  && (voice.get('duckDb', null) == null
                      || (voice.duckDb is number && voice.duckDb >= -40 && voice.duckDb <= 0))
                  && (voice.get('captions', null) == null
                      || voice.captions in ['REBUILD', 'KEEP', 'REMOVE'])
                );
    }

    // What to hide in the picture: rectangles, in percentages of the SOURCE
    // frame, plus a flag asking the worker to go and find some.
    //
    // **This is written against an evaluation budget, not for elegance.** A
    // Firestore rule may evaluate a thousand expressions and no more, and the
    // first version of this — eleven named keys and a typed range check on
    // every field, unrolled over eight regions — exceeded it, denying a write
    // that was perfectly valid with an error naming neither the field nor the
    // reason. So it checks the two things only the rule can check, and leaves
    // the rest to the worker's own schema, which rejects an unknown method or
    // an out-of-range strength with a message that says so.
    //
    // What only the rule can check is the **key set** — a field nobody
    // recognises is how something gets smuggled past a validator — and the
    // **geometry**, because a zero-width rectangle is clamped to nothing on the
    // worker and would hide neither the logo nor the reason it was not hidden.
    //
    // The cap is six because each region becomes a split/crop/overlay triple or
    // a delogo in the filtergraph AND a full-frame filter pass at encode time.
    // Detection never returns more than four, and no broadcast carries six
    // marks, so this is headroom rather than a limit anyone meets.
    function obscureRegionOk(region) {
      return region.keys().hasOnly(
               ['xPct', 'yPct', 'wPct', 'hPct', 'method', 'strength',
                'fromSec', 'toSec', 'label', 'found', 'confidence'])
             && region.xPct >= 0 && region.yPct >= 0
             && region.wPct > 0 && region.hPct > 0
             && region.xPct + region.wPct <= 100
             && region.yPct + region.hPct <= 100;
    }

    function obscureRegionsOk(regions) {
      // Rules have no map over a list, so the members are checked positionally.
      // Short-circuiting means the ordinary one- or two-region write evaluates
      // almost none of this.
      return regions.size() <= 6
             && (regions.size() < 1 || obscureRegionOk(regions[0]))
             && (regions.size() < 2 || obscureRegionOk(regions[1]))
             && (regions.size() < 3 || obscureRegionOk(regions[2]))
             && (regions.size() < 4 || obscureRegionOk(regions[3]))
             && (regions.size() < 5 || obscureRegionOk(regions[4]))
             && (regions.size() < 6 || obscureRegionOk(regions[5]));
    }

    function obscureOk(obscure) {
      return obscure == null
             || (
                  obscure.keys().hasOnly(['auto', 'regions', 'method', 'strength'])
                  && (obscure.get('regions', null) == null
                      || obscureRegionsOk(obscure.regions))
                );
    }

    function remakeOptionsOk() {
      let options = request.resource.data.get('remakeOptions', null);
      return options != null
             && options.keys().hasOnly(
                  ['notes', 'interpretNotes', 'framing', 'voice',
                   'startDeltaSec', 'endDeltaSec', 'profile', 'obscure',
                   'keepMusic', 'captions'])
             // Captions are a property of the picture, so this stands beside
             // `voice` rather than inside it. REBUILD is meaningless without a
             // new narration to transcribe, and the stage ignores it here.
             && (options.get('captions', null) == null
                 || options.captions in ['KEEP', 'REMOVE', 'REBUILD'])
             && (options.get('notes', null) == null
                 || (options.notes is string && options.notes.size() <= 2000))
             && (options.get('interpretNotes', null) == null || options.interpretNotes is bool)
             // A profile NAME, not a path. The worker joins this into
             // assets/profiles/<name>.toml, so a value carrying a separator or a
             // dot reaches outside that directory — and it is stamped onto the
             // finished clip as its renderProfile either way. Every other helper
             // here constrains its value rather than only its type.
             && (options.get('profile', null) == null
                 || (options.profile is string
                     && options.profile.size() > 0
                     && options.profile.size() <= 64
                     && options.profile.matches('^[A-Za-z0-9_-]+$')))
             && (options.get('startDeltaSec', null) == null
                 || (options.startDeltaSec is number
                     && options.startDeltaSec >= -30 && options.startDeltaSec <= 30))
             && (options.get('endDeltaSec', null) == null
                 || (options.endDeltaSec is number
                     && options.endDeltaSec >= -30 && options.endDeltaSec <= 30))
             // Null and true both mean "carry the clip's soundtrack into the
             // remake"; only false drops it. Type-checked here as well as listed
             // in hasOnly because hasOnly alone would let a string through, and
             // the worker reads this as a boolean.
             && (options.get('keepMusic', null) == null || options.keepMusic is bool)
             && framingOk(options.get('framing', null))
             && voiceOk(options.get('voice', null))
             && obscureOk(options.get('obscure', null));
    }

    // What the operator chose for one specific upload: title, description,
    // privacy, category, tags, and which channel. Every field is optional and
    // null means "use the channel's default", so this validates *shape*, not
    // presence.
    //
    // Worth validating at all because these values leave the system. A title is
    // published under the operator's own name and a privacy of 'public' is not
    // recoverable, so a client that could write an unrecognised field here
    // would be a client that could smuggle one past the worker's resolver. The
    // caps are YouTube's own limits, enforced early: an oversized title fails
    // here, before an encode and a review, instead of at the upload.
    //
    // `tags` is capped for a different reason — the resolver only sends the
    // first twenty, so a longer list is document size that will never be used.
    function publishOptionsOk() {
      let options = request.resource.data.get('publishOptions', null);
      return options == null
             || (
                  options.keys().hasOnly(
                    ['channelId', 'title', 'description', 'privacy', 'categoryId', 'tags'])
                  && (options.get('channelId', null) == null
                      || options.channelId is string)
                  && (options.get('title', null) == null
                      || (options.title is string && options.title.size() <= 100))
                  && (options.get('description', null) == null
                      || (options.description is string && options.description.size() <= 4900))
                  && (options.get('privacy', null) == null
                      || options.privacy in ['private', 'unlisted', 'public'])
                  && (options.get('categoryId', null) == null
                      || options.categoryId is string)
                  && (options.get('tags', null) == null
                      || (options.tags is list && options.tags.size() <= 20))
                );
    }

    // What a RESEARCH job may ask for. Every field is optional — an empty
    // object means "whatever is trending" — but each one that is present is
    // bounded, because every topic is a search against somebody else's server
    // and the worst case has to be a known number of requests.
    function researchOptionsOk() {
      return researchOptionsShapeOk(request.resource.data.get('researchOptions', null));
    }

    // The same shape, wherever it appears: on a job, and on the schedule that
    // will one day put it on a job.
    function researchOptionsShapeOk(options) {
      return options != null
             && options.keys().hasOnly(
                  ['topics', 'region', 'lookbackHours', 'videosPerTopic', 'maxTrends',
                   'sources', 'subreddits', 'curate'])
             && (options.get('topics', null) == null
                 || (options.topics is list && options.topics.size() <= 12))
             && (options.get('region', null) == null
                 || (options.region is string && options.region.matches('^[A-Z]{2}$')))
             && (options.get('lookbackHours', null) == null
                 || (options.lookbackHours is int
                     && options.lookbackHours >= 6 && options.lookbackHours <= 168))
             && (options.get('videosPerTopic', null) == null
                 || (options.videosPerTopic is int
                     && options.videosPerTopic >= 1 && options.videosPerTopic <= 10))
             && (options.get('maxTrends', null) == null
                 || (options.maxTrends is int
                     && options.maxTrends >= 1 && options.maxTrends <= 30))
             && (options.get('sources', null) == null
                 || (options.sources is list
                     && options.sources.size() <= 3
                     && options.sources.hasOnly(['GOOGLE_TRENDS', 'REDDIT', 'YOUTUBE'])))
             && (options.get('subreddits', null) == null
                 || (options.subreddits is list
                     && options.subreddits.size() <= 10
                     && subredditsOk(options.subreddits)))
             && (options.get('curate', null) == null || options.curate is bool);
    }

    // A subreddit name is joined into a URL on the worker, so it has to be a
    // name and not a path. Checked positionally, as obscureRegionsOk is.
    function subredditOk(name) {
      return name is string && name.size() > 0 && name.size() <= 40
             && name.matches('^[A-Za-z0-9_]+$');
    }

    function subredditsOk(names) {
      return (names.size() < 1 || subredditOk(names[0]))
             && (names.size() < 2 || subredditOk(names[1]))
             && (names.size() < 3 || subredditOk(names[2]))
             && (names.size() < 4 || subredditOk(names[3]))
             && (names.size() < 5 || subredditOk(names[4]))
             && (names.size() < 6 || subredditOk(names[5]))
             && (names.size() < 7 || subredditOk(names[6]))
             && (names.size() < 8 || subredditOk(names[7]))
             && (names.size() < 9 || subredditOk(names[8]))
             && (names.size() < 10 || subredditOk(names[9]));
    }

    // What a COMPILE job may ask for. Each item reaches yt-dlp exactly as a
    // CLIP submission does, and the window numbers reach ffmpeg, so the same
    // bounds apply. Two items minimum: one is a clip, not a compilation.
    function compileItemOk(item) {
      return item.keys().hasOnly(['submission', 'startSec', 'endSec', 'note'])
             && item.submission is string
             && item.submission.size() > 0
             && item.submission.size() <= 2048
             && (item.get('startSec', null) == null
                 || (item.startSec is number && item.startSec >= 0))
             && (item.get('endSec', null) == null
                 || (item.endSec is number && item.endSec >= 0))
             && (item.get('note', null) == null
                 || (item.note is string && item.note.size() <= 300));
    }

    function compileItemsOk(items) {
      // Positional, as obscureRegionsOk is: rules have no map over a list.
      return items.size() >= 2 && items.size() <= 12
             && compileItemOk(items[0])
             && compileItemOk(items[1])
             && (items.size() < 3 || compileItemOk(items[2]))
             && (items.size() < 4 || compileItemOk(items[3]))
             && (items.size() < 5 || compileItemOk(items[4]))
             && (items.size() < 6 || compileItemOk(items[5]))
             && (items.size() < 7 || compileItemOk(items[6]))
             && (items.size() < 8 || compileItemOk(items[7]))
             && (items.size() < 9 || compileItemOk(items[8]))
             && (items.size() < 10 || compileItemOk(items[9]))
             && (items.size() < 11 || compileItemOk(items[10]))
             && (items.size() < 12 || compileItemOk(items[11]));
    }

    function compileOptionsOk() {
      let options = request.resource.data.get('compileOptions', null);
      return options != null
             && options.keys().hasOnly(
                  ['theme', 'title', 'items', 'targetDurationSec', 'maxSegmentSec',
                   'captions', 'titleCard', 'transition', 'trendId'])
             && options.theme is string
             && options.theme.size() > 0
             && options.theme.size() <= 200
             && (options.get('title', null) == null
                 || (options.title is string && options.title.size() <= 200))
             && options.items is list
             && compileItemsOk(options.items)
             && (options.get('targetDurationSec', null) == null
                 || (options.targetDurationSec is int
                     && options.targetDurationSec >= 20 && options.targetDurationSec <= 180))
             && (options.get('maxSegmentSec', null) == null
                 || (options.maxSegmentSec is int
                     && options.maxSegmentSec >= 5 && options.maxSegmentSec <= 60))
             && (options.get('captions', null) == null || options.captions is bool)
             && (options.get('titleCard', null) == null || options.titleCard is bool)
             && (options.get('transition', null) == null
                 || options.transition in ['CUT', 'FADE'])
             && (options.get('trendId', null) == null || options.trendId is string);
    }

    // ── Jobs ─────────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if isApproved();

      // The PWA may enqueue work, but only as itself and only in the one state
      // that means "not yet started". It may not create a job that is already
      // RUNNING, already has a worker, or already holds a lease.
      //
      // A PUBLISH job additionally has to name a clip that is approved. This
      // costs one document read per publish request; publishing is rare —
      // YouTube's quota allows about six a day — so that is the right place to
      // spend one.
      allow create: if ownsIncoming()
                    && request.resource.data.status == 'QUEUED'
                    && request.resource.data.workerId == null
                    && request.resource.data.leaseExpiresAt == null
                    && request.resource.data.attempts == 0
                    && publishOptionsOk()
                    && (
                         request.resource.data.type != 'PUBLISH'
                         || (
                              request.resource.data.clipId is string
                              && publishable(request.resource.data.clipId)
                            )
                       )
                    // A MUSIC job names a clip and says what to do to it. It
                    // does NOT require the clip to be approved: choosing a
                    // track is part of deciding whether the clip is any good,
                    // and the scored version is reviewed on its own merits.
                    && (
                         request.resource.data.type != 'MUSIC'
                         || (
                              request.resource.data.clipId is string
                              && exists(/databases/$(database)/documents/clips/$(request.resource.data.clipId))
                              && musicOptionsOk()
                            )
                       )
                    // An UPLOAD job asks the worker to put one clip in the
                    // bucket so a phone can play it. Like MUSIC it does not
                    // require approval — being unable to watch a clip is
                    // precisely why it has not been reviewed yet — but it must
                    // name a clip that exists, or the worker claims a job it
                    // can only fail.
                    && (
                         request.resource.data.type != 'UPLOAD'
                         || (
                              request.resource.data.clipId is string
                              && exists(/databases/$(database)/documents/clips/$(request.resource.data.clipId))
                            )
                       )
                    // A REMAKE job is a correction to a clip someone is
                    // watching. Like MUSIC and UPLOAD it does not require
                    // approval — the whole point is that the clip is *not*
                    // right yet — but it must name a clip that exists, and its
                    // options must be values the worker can actually render.
                    && (
                         request.resource.data.type != 'REMAKE'
                         || (
                              request.resource.data.clipId is string
                              && exists(/databases/$(database)/documents/clips/$(request.resource.data.clipId))
                              && remakeOptionsOk()
                            )
                       )
                    // A RESEARCH job names no clip and no source. It asks the
                    // worker a question, and the only thing to check is that
                    // the question is one the worker can bound.
                    && (request.resource.data.type != 'RESEARCH' || researchOptionsOk())
                    // A COMPILE job is several submissions and a theme. Like
                    // CLIP it needs nothing to exist yet; unlike CLIP its
                    // options are a document, and that document is checked.
                    && (request.resource.data.type != 'COMPILE' || compileOptionsOk());

      // The only state transition a user may drive is cancellation. Everything
      // else — claiming, progress, stage results — belongs to the worker.
      //
      // `changed().hasOnly` is what protects attribution here: `uid` is not in
      // the writable set, so cancelling someone else's job cannot quietly
      // reassign it to the person who cancelled it.
      allow update: if isApproved()
                    && request.resource.data.status == 'CANCELLED'
                    && resource.data.status in ['QUEUED', 'RUNNING']
                    && changed().hasOnly(['status', 'updatedAt', 'endedAt']);

      allow delete: if isApproved();

      // ── Job events ─────────────────────────────────────────────────────────
      // Append-only, written by the worker. Readable so a failure can be
      // diagnosed from the phone rather than from worker logs.
      //
      // This used to `get()` the parent job to compare its uid, which is now
      // both pointless and expensive — a rule `get()` is a billed read, on
      // every event of every log.
      match /events/{eventId} {
        allow read: if isApproved();
        allow write: if false;
      }
    }

    // ── Sources ──────────────────────────────────────────────────────────────
    match /sources/{sourceId} {
      allow read: if isApproved();
      allow create: if ownsIncoming();

      // Deleting a source is the client's job to cascade: it deletes the
      // candidates and clips cut from it in the same batch, so the tree goes in
      // one atomic write rather than leaving clips pointing at a source that is
      // no longer there. Rules cannot enforce that — they see one document at
      // a time — so it is enforced where it can be, in `deleteSource`, and the
      // worker tolerates the orphan either way.
      allow delete: if isApproved();

      // `obscure` is the one field on a source a person owns, and it is here
      // rather than on each clip because what it describes is a property of the
      // channel: a broadcaster's bug is in the same place on every video it
      // will ever publish, so the rectangle is worth recording once against the
      // source and applying at RENDER ever after.
      //
      // Everything else about a source is a fact about a file — its hash, its
      // path on the worker, how large it is — and a client that could write
      // those could point a render at a file nobody ingested. So the field set
      // is pinned to exactly one name, and `uid` is compared so the write
      // cannot also reassign ownership.
      allow update: if isApproved()
                    && changed().hasOnly(['obscure'])
                    && request.resource.data.uid == resource.data.uid
                    && obscureOk(request.resource.data.get('obscure', null));

      // Transcripts are expensive to produce and are cached by content hash.
      // Nothing about them is user-editable.
      match /transcripts/{modelVersion} {
        allow read: if isApproved();
        allow write: if false;
      }

      // The thumbnail on the Sources page. A subcollection for the same reason
      // a clip's poster is one: listing the library must not drag an image per
      // row. Produced by the worker on ingest, from a file only the worker can
      // reach, so a client may look and never write.
      match /preview/{previewId} {
        allow read: if isApproved();
        allow write: if false;
      }
    }

    // ── Channels ─────────────────────────────────────────────────────────────
    // Publishing destinations. Written by the worker, which is the only thing
    // that can actually reach a channel, and read by any approved user so the
    // settings page can show connection state and quota.
    //
    // Deliberately holds no credentials: the client secret and refresh token
    // stay on the worker (docs/adr/0010-worker-held-publishing-credentials.md).
    // If a field ever appears here that could publish to a channel, this rule is
    // the wrong shape and the field is in the wrong place.
    match /channels/{channelId} {
      allow read: if isApproved();
      allow write: if false;
    }

    // ── Candidates ───────────────────────────────────────────────────────────
    // Produced by the ANALYZE stage. Read-only to the client: a user who could
    // write these could fabricate a score and corrupt the Phase 9 feedback loop.
    match /candidates/{candidateId} {
      allow read: if isApproved();
      // Read-only to the client: a user who could write these could fabricate a
      // score and corrupt the Phase 9 feedback loop. Deleting one fabricates
      // nothing — it is a proposal nobody acted on, and the ones that were
      // acted on are identifiable from the clips that carry their ids.
      allow create, update: if false;
      allow delete: if isApproved();
    }

    // ── Clips ────────────────────────────────────────────────────────────────
    // ── Schedules ────────────────────────────────────────────────────────────
    // A standing request for research. The client owns the request — what to
    // look for, how often, whether it is on — and the worker owns the record
    // of what it did with it (lastRunAt, lastJobId, lastOutcome). Any approved
    // member may edit any schedule, as with jobs: one workspace, one channel's
    // worth of curiosity. The shape is checked because everything in `options`
    // reaches three outside services and yt-dlp on the worker, on a timer,
    // with nobody watching.
    function timeOfDayOk(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function everyHoursOk(value) {
      return value is int && value >= 6 && value <= 168;
    }

    function scheduleOk() {
      let s = request.resource.data;
      return s.keys().hasOnly(
               ['id', 'uid', 'name', 'enabled', 'cadence', 'everyHours', 'at', 'timezone',
                'options', 'nextDueAt', 'lastRunAt', 'lastJobId', 'lastOutcome',
                'createdAt', 'updatedAt'])
             && s.name is string && s.name.size() > 0 && s.name.size() <= 80
             && s.enabled is bool
             && s.cadence in ['INTERVAL', 'DAILY']
             // The field the cadence needs has to be there; the other may be.
             && (s.cadence != 'INTERVAL' || everyHoursOk(s.get('everyHours', null)))
             && (s.cadence != 'DAILY' || timeOfDayOk(s.get('at', null)))
             && (s.get('everyHours', null) == null || everyHoursOk(s.everyHours))
             && (s.get('at', null) == null || timeOfDayOk(s.at))
             && (s.get('timezone', null) == null
                 || (s.timezone is string && s.timezone.size() <= 64))
             && researchOptionsShapeOk(s.get('options', null))
             && (s.get('nextDueAt', null) == null || s.nextDueAt is string)
             && s.createdAt is string
             && s.updatedAt is string;
    }

    match /schedules/{scheduleId} {
      allow read: if isApproved();

      // Created blank on the worker's side: a schedule cannot arrive claiming
      // to have already run.
      allow create: if ownsIncoming()
                    && scheduleOk()
                    && request.resource.data.get('lastRunAt', null) == null
                    && request.resource.data.get('lastJobId', null) == null
                    && request.resource.data.get('lastOutcome', null) == null;

      // Everything about the request may change; nothing about the record may,
      // and neither may who set it up.
      allow update: if isApproved()
                    && scheduleOk()
                    && changed().hasOnly(
                         ['name', 'enabled', 'cadence', 'everyHours', 'at', 'timezone',
                          'options', 'nextDueAt', 'updatedAt']);

      allow delete: if isApproved();
    }

    // ── Trends ───────────────────────────────────────────────────────────────
    // What a RESEARCH run found, one row per topic. Written by the worker:
    // the score, the rank, the videos and what the model said are all
    // evidence, and a client that could rewrite them could make the list say
    // anything. What a person owns is the decision — promoted, dismissed, or
    // not yet — and that is the only thing a client may change, under its own
    // name. Deleting is allowed for the same reason a job may be deleted: a
    // stale list is clutter, and there are no files behind it.
    match /trends/{trendId} {
      allow read: if isApproved();
      allow create: if false;
      allow update: if isApproved()
                    && changed().hasOnly(['status', 'decidedAt', 'decidedBy'])
                    && request.resource.data.status in ['NEW', 'PROMOTED', 'DISMISSED']
                    && (request.resource.data.get('decidedBy', null) == null
                        || request.resource.data.decidedBy == request.auth.uid);
      allow delete: if isApproved();
    }

    // ── Preferences ──────────────────────────────────────────────────────────
    //
    // What the system has worked out about a reviewer from their corrections,
    // proposed after a remake and applied to later ones only once accepted.
    //
    // The client's only power here is the decision. It cannot create a
    // preference — the worker proposes them through the Admin SDK — and it
    // cannot edit the text of one, because a preference whose wording could be
    // rewritten after it was accepted would be a rule nobody had agreed to.
    // Accepting and rejecting are the same write: `status` plus who decided and
    // when, and nothing else in the document may move.
    match /preferences/{preferenceId} {
      allow read: if isApproved();

      allow update: if isApproved()
                    && changed().hasOnly(['status', 'decidedAt', 'decidedBy'])
                    && request.resource.data.status in ['ACCEPTED', 'REJECTED']
                    && request.resource.data.decidedBy == request.auth.uid
                    && request.resource.data.decidedAt is string;

      // Proposing is the worker's job; deleting is nobody's. A rejected
      // preference is kept deliberately, so the same suggestion cannot come
      // back on the next correction — the rejection is itself the thing worth
      // remembering, and removing the row would restart the loop it ended.
      allow create, delete: if false;
    }

    // ── Phase 9: measured performance, and what was concluded from it ────────
    // Both are read-only to every client, and that is the whole rule. The
    // worker writes them through the Admin SDK, which bypasses rules entirely,
    // so there is no write surface to design here — only one to refuse.
    //
    // Refusing it matters more than usual. These two collections are the
    // *evidence*: `metrics` is what actually happened to a published clip, and
    // `calibrations` is what was concluded from it on a given date. A client
    // that could edit either could make the scoring look better than it was,
    // which would make the one falsifiable thing in this project unfalsifiable.
    match /metrics/{snapshotId} {
      allow read: if isApproved();
      allow write: if false;
    }

    // Append-only by intent, and by the same rule as above: a report is a
    // record of what was believed on a date. Overwriting one would erase the
    // fact that the conclusion changed, which is the single most interesting
    // thing a sequence of these can show.
    match /calibrations/{reportId} {
      allow read: if isApproved();
      allow write: if false;
    }

    match /clips/{clipId} {
      allow read: if isApproved();
      allow create: if false;

      // **Deleting a clip deletes the record, never the file.** They are
      // separate acts because they answer separate questions, and the second
      // one is the expensive one to get wrong: a clip is a render that cost GPU
      // time and a source is a download that may no longer be available. So
      // this clears the review queue, and the media stays exactly where it is
      // until somebody removes it from the machine that holds it — which is a
      // different surface, on the worker, because nothing in Firestore knows
      // what is on a particular disk.
      //
      // A publication is NOT deleted with its clip. It is the record of what
      // was actually posted and where, and an audit trail that disappears when
      // somebody tidies their queue is not an audit trail.
      allow delete: if isApproved();

      // Review is the decision the people own; everything else about a clip
      // belongs to the render that produced it. Restricting the writable field
      // set is what keeps that line: publishing is gated on `review`, so a rule
      // that allowed a blanket update would let a client relabel storagePath or
      // rewrite the render's own record of itself. It also pins `uid`, so
      // reviewing a clip never reassigns who made it.
      //
      // `storagePath` and `playbackExpiresAt` are writable, and only to null.
      // They describe a *cache* — a short-lived bucket copy that exists so a
      // phone can watch the clip — and the client is what deletes that object
      // when a decision makes it pointless. Letting it clear the pointer in the
      // same breath keeps the document honest about what is in the bucket. It
      // is not an exception to "the client may not write pipeline state": the
      // render itself is `localPath`, which stays untouchable.
      // `supersededAt` is a decision, not pipeline state: it records that a
      // later version of this clip was approved, which is something only the
      // reviewer knows. It is write-once-ish by intent — a timestamp or null,
      // never anything else — and the worker's tidy pass is what acts on it.
      allow update: if isApproved()
                    && changed().hasOnly(['review', 'reviewedAt', 'reviewNote',
                                          'title', 'description', 'storagePath',
                                          'playbackExpiresAt', 'supersededAt'])
                    && request.resource.data.review in ['PENDING', 'APPROVED', 'REJECTED']
                    && (!('supersededAt' in changed())
                        || request.resource.data.supersededAt == null
                        || request.resource.data.supersededAt is string)
                    && (!('storagePath' in changed())
                        || request.resource.data.storagePath == null)
                    && (!('playbackExpiresAt' in changed())
                        || request.resource.data.playbackExpiresAt == null);

      // The poster frame and filmstrip. On the free tier this is the only part
      // of a clip a phone can see at all, so it is read-often and must stay
      // readable — but it is produced by the render stage, never by a client.
      // See docs/adr/0009-spark-tier-local-artefacts.md.
      match /preview/{previewId} {
        allow read: if isApproved();
        allow write: if false;
      }

      match /publications/{pubId} {
        allow read: if isApproved();
        allow write: if false;
      }

      // Metrics are NOT here. They were anticipated as a subcollection and
      // never written as one: every question Phase 9 asks spans clips, so they
      // live in the top-level `metrics` collection above. This comment stands
      // in for the rule that used to be here, so nobody re-derives the
      // subcollection from its absence.
    }

    // ── Everything else ──────────────────────────────────────────────────────
    // Default deny. A new collection is inaccessible until it is granted access
    // deliberately, rather than inheriting a permissive fallback.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
