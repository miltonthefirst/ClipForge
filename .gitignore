# --- Secrets: never commit ---
.env
.env.*
!.env.example
*serviceAccount*.json
*service-account*.json
firebase/**/serviceAccount*.json
apps/worker/.clipforge/
**/credentials/
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Node / Angular ---
node_modules/
/apps/web/dist/
/apps/web/.angular/
/apps/web/coverage/
/firebase/functions/lib/
npm-debug.log*
yarn-error.log*

# --- Firebase ---
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# --- ClipForge workspace: large media, never committed ---
workspace/
apps/worker/workspace/
*.mp4
*.mkv
*.webm
*.m4a
*.wav
!apps/worker/assets/fixtures/**/*.wav
!apps/worker/assets/fixtures/**/*.mp4

# --- Editors ---
# `.vscode/*` contains a slash, so it anchors to this file's directory only.
# `**/` makes it apply at every depth - which is what let apps/web/.vscode
# through the first time.
**/.vscode/*
!**/.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# --- Logs and scratch ---
*.log
tmp/
temp/
.cache/

# --- Angular / Node build caches ---
.angular/
coverage/
*.tsbuildinfo
.eslintcache

# --- Firebase emulator artefacts ---
firebase-export-*/
.runtimeconfig.json
emulator-data/

# --- Model caches, if ever placed inside the repo ---
# NOTE: deliberately NOT `models/` - apps/worker/clipforge/models is source.
.huggingface/
whisper-models/
