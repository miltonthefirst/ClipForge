# --- Secrets: never commit ---
.env
.env.*
!.env.example
*serviceAccount*.json
*service-account*.json
firebase/**/serviceAccount*.json
# The Firebase console names downloaded Admin SDK keys
# "<project>-firebase-adminsdk-<id>-<hash>.json", which matched none of the
# patterns above — so one arrived at the repo root untracked and unignored, a
# single `git add -A` away from being published. Matched three ways now.
*firebase-adminsdk*
*-adminsdk-*.json
*adminsdk*.json
apps/worker/.clipforge/
# Wherever the worker is started from — the token store is a relative path by
# default, so a run from the repo root puts it here instead.
.clipforge/
*youtube-token*
*client_secret*.json
**/credentials/
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Tauri desktop shell ---
# `frontend/` is a staged copy of the Angular build with desktop config injected;
# `target/` is Rust's build output and is measured in gigabytes.
/apps/desktop/frontend/
/apps/desktop/src-tauri/target/
/apps/desktop/src-tauri/gen/

# --- Node / Angular ---
node_modules/
/apps/web/dist/
/apps/web/.angular/
/apps/web/coverage/
/firebase/functions/lib/
npm-debug.log*
yarn-error.log*

# --- Firebase ---
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# --- ClipForge workspace: large media, never committed ---
workspace/
apps/worker/workspace/
*.mp4
*.mkv
*.webm
*.m4a
*.wav
!apps/worker/assets/fixtures/**/*.wav
!apps/worker/assets/fixtures/**/*.mp4
!apps/worker/assets/fixtures/**/*.mp3

# Your own voice recording, if you add one. Deliberately NOT committed: a test
# needing a fixture is no reason for your voice to end up in a public repo.
# See apps/worker/assets/fixtures/speech/SOURCES.md.
apps/worker/assets/fixtures/speech/custom/*
!apps/worker/assets/fixtures/speech/custom/.gitkeep

# --- Editors ---
# `.vscode/*` contains a slash, so it anchors to this file's directory only.
# `**/` makes it apply at every depth - which is what let apps/web/.vscode
# through the first time.
**/.vscode/*
!**/.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# --- Logs and scratch ---
*.log
tmp/
temp/
.cache/

# --- Angular / Node build caches ---
.angular/
coverage/
*.tsbuildinfo
.eslintcache

# --- Firebase emulator artefacts ---
firebase-export-*/
.runtimeconfig.json
emulator-data/

# --- Model caches, if ever placed inside the repo ---
# NOTE: deliberately NOT `models/` - apps/worker/clipforge/models is source.
.huggingface/
whisper-models/
