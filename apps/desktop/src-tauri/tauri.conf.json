{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ClipForge",
  "version": "0.1.0",
  "identifier": "dev.bytepic.clipforge",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://127.0.0.1:4300"
  },
  "app": {
    "windows": [
      {
        "title": "ClipForge",
        "width": 1100,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "BytePic",
    "shortDescription": "Review AI-selected clips on the machine that renders them",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
