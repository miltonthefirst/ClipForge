# ClipForge — environment template
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
#
# NOTE: project ids, bucket names and emulator hosts are configuration ONLY.
# Nothing in source may hardcode them — see docs/PLAN.md, Phase 1 addendum.
# This is what makes moving between Firebase projects a one-file change.

# ─────────────────────────────────────────────────────────────────────────────
# Firebase — control plane
# ─────────────────────────────────────────────────────────────────────────────
# Temporary gateway project while the `ClipForge` project's upgrade is blocked.
CLIPFORGE_FIREBASE_PROJECT_ID=miltongore
CLIPFORGE_FIREBASE_STORAGE_BUCKET=

# Absolute path to the Admin SDK service-account JSON used by the worker.
# Keep this OUTSIDE the repository. Never commit the file itself.
CLIPFORGE_GOOGLE_APPLICATION_CREDENTIALS=

# Emulator Suite. When `true`, the worker and web app talk to local emulators and
# NO real Firebase project or billing is required at all.
CLIPFORGE_USE_EMULATORS=true
CLIPFORGE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
CLIPFORGE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
CLIPFORGE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ─────────────────────────────────────────────────────────────────────────────
# Worker — identity and scheduling
# ─────────────────────────────────────────────────────────────────────────────
CLIPFORGE_WORKER_ID=
CLIPFORGE_LEASE_SECONDS=90
CLIPFORGE_HEARTBEAT_SECONDS=30
CLIPFORGE_MAX_ATTEMPTS=3

# Scheduler lanes. The GPU lane MUST stay at 1 — see docs/PLAN.md §2.1.
CLIPFORGE_GPU_LANE_DEPTH=1
CLIPFORGE_CPU_LANE_DEPTH=3

# ─────────────────────────────────────────────────────────────────────────────
# Workspace — local media storage
# ─────────────────────────────────────────────────────────────────────────────
CLIPFORGE_WORKSPACE_DIR=./workspace
CLIPFORGE_WORKSPACE_MAX_GB=60

# ─────────────────────────────────────────────────────────────────────────────
# Models
# ─────────────────────────────────────────────────────────────────────────────
CLIPFORGE_WHISPER_MODEL=large-v3-turbo
CLIPFORGE_WHISPER_COMPUTE_TYPE=int8_float16
CLIPFORGE_WHISPER_DEVICE=cuda

CLIPFORGE_OLLAMA_HOST=http://127.0.0.1:11434
CLIPFORGE_OLLAMA_MODEL=qwen3.5:4b
CLIPFORGE_OLLAMA_NUM_CTX=16384

# VRAM headroom reserved for the desktop/browser, in MiB. The ModelBroker refuses
# to load a model that would not fit in (total - reserve).
CLIPFORGE_VRAM_RESERVE_MB=700

# ─────────────────────────────────────────────────────────────────────────────
# Media / render
# ─────────────────────────────────────────────────────────────────────────────
CLIPFORGE_FFMPEG_BIN=ffmpeg
CLIPFORGE_FFPROBE_BIN=ffprobe
CLIPFORGE_RENDER_PROFILE=default
CLIPFORGE_VIDEO_ENCODER=h264_nvenc
CLIPFORGE_LOUDNESS_TARGET_LUFS=-14

# ─────────────────────────────────────────────────────────────────────────────
# Publishing (Phase 8) — OFF by default.
# Credentials live on the worker only and are NEVER written to Firestore.
# ─────────────────────────────────────────────────────────────────────────────
CLIPFORGE_PUBLISHING_ENABLED=false
CLIPFORGE_YOUTUBE_CLIENT_SECRETS=
CLIPFORGE_YOUTUBE_TOKEN_STORE=./.clipforge/youtube-token.enc
CLIPFORGE_YOUTUBE_DEFAULT_PRIVACY=unlisted

# ─────────────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────────────
CLIPFORGE_LOG_LEVEL=INFO
CLIPFORGE_LOG_FORMAT=console
