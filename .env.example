# ClipForge — environment template
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
#
# NOTE: project ids, bucket names and emulator hosts are configuration ONLY.
# Nothing in source may hardcode them — see docs/PLAN.md, Phase 1 addendum.
# This is what makes moving between Firebase projects a one-file change.

# ─────────────────────────────────────────────────────────────────────────────
# Firebase — control plane
# ─────────────────────────────────────────────────────────────────────────────
# ClipForge's own Firebase project. It is deliberately NOT shared with any other
# project: see docs/adr/0004-dedicated-firebase-project.md.
#
# Every Firebase CLI invocation must pass this explicitly (`--project`). Never run
# a bare `firebase deploy` — deploys REPLACE rather than merge, so an ambient or
# mistyped project id can overwrite an unrelated project's rules, functions or
# hosting site.
CLIPFORGE_FIREBASE_PROJECT_ID=bytepic-clipforge

# ─────────────────────────────────────────────────────────────────────────────
# Firebase — the PWA's client config
# ─────────────────────────────────────────────────────────────────────────────
# From the Firebase console: Project settings -> Your apps -> Web app -> SDK
# setup and configuration. Register a Web app first if there is not one yet.
#
# These are NOT secrets. A Firebase web apiKey identifies the project; it does
# not authorise anything on its own. What protects the data is firestore.rules
# plus Authentication, which is why those are the things with tests.
#
# `tools/deploy.ps1` reads these and inlines them into the deployed index.html.
# Leave them empty to keep the app pointed at the local emulators.
CLIPFORGE_WEB_API_KEY=
CLIPFORGE_WEB_AUTH_DOMAIN=bytepic-clipforge.firebaseapp.com
CLIPFORGE_WEB_APP_ID=

# Where the deployed PWA looks for clips that never left the worker. Playback
# branch 2 only resolves when the browser is ON the worker machine; from a phone
# it falls through to the poster frame, which is the expected free-tier case.
# See docs/adr/0009-spark-tier-local-artefacts.md.
CLIPFORGE_WEB_LOCAL_SERVER_ORIGIN=http://127.0.0.1:8770

# The bucket name from the Firebase console (Storage → Files); it looks like
# `your-project.firebasestorage.app`. Required by CLIPFORGE_BLOB_STORE=firebase
# and ignored otherwise. Leave EMPTY on the Spark free tier, where there is no
# bucket at all. See docs/adr/0009-spark-tier-local-artefacts.md.
CLIPFORGE_FIREBASE_STORAGE_BUCKET=

# ─────────────────────────────────────────────────────────────────────────────
# Artefact storage — the one switch the Blaze upgrade flips
# ─────────────────────────────────────────────────────────────────────────────
# local    — clips are written to the workspace and never uploaded. The only
#            option that works without Blaze. Reviewable on this machine only.
# firebase — clips are written to the workspace AND uploaded, so a phone can
#            play them. The local copy is still the one that gets published and
#            the one that survives; the bucket copy is a short-lived
#            convenience. Requires Blaze and a bucket above.
CLIPFORGE_BLOB_STORE=local

# How long a clip stays in the bucket. The deletion itself is done by a Cloud
# Storage lifecycle rule rather than by any code here — apply it with
#   pwsh -File tools/storage-lifecycle.ps1
# which reads this value. The worker records the same deadline on each clip so
# the app stops offering a video the bucket has already collected. A reviewed
# clip is dropped sooner: once you have decided, its copy has no job left.
CLIPFORGE_CLIP_RETENTION_DAYS=5

# The worker serves its workspace read-only so the PWA can play clips when it is
# opened ON THIS MACHINE. Browsers exempt localhost from mixed-content blocking,
# so this works even with the PWA served over HTTPS.
#
# Keep the host at 127.0.0.1. This is a convenience, not an authenticated
# surface: binding it to 0.0.0.0 would expose the workspace to the whole network.
CLIPFORGE_LOCAL_SERVER_ENABLED=true
CLIPFORGE_LOCAL_SERVER_HOST=127.0.0.1
# Port note: 8765 is a common default and collides easily — on this machine an
# unrelated app already held it, ClipForge's server failed to bind, and every
# clip pointed at that app's 404. The PWA now verifies it is talking to
# ClipForge before building a local URL, so a clash degrades to the cloud copy
# instead of a broken player; moving off the contended port is the other half.
CLIPFORGE_LOCAL_SERVER_PORT=8770

# Absolute path to the Admin SDK service-account JSON used by the worker.
# Keep this OUTSIDE the repository. Never commit the file itself.
CLIPFORGE_GOOGLE_APPLICATION_CREDENTIALS=

# Emulator Suite. When `true`, the worker and web app talk to local emulators and
# NO real Firebase project or billing is required at all.
CLIPFORGE_USE_EMULATORS=true
CLIPFORGE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
CLIPFORGE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
CLIPFORGE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ─────────────────────────────────────────────────────────────────────────────
# Worker — identity and scheduling
# ─────────────────────────────────────────────────────────────────────────────
CLIPFORGE_WORKER_ID=
CLIPFORGE_LEASE_SECONDS=90
CLIPFORGE_HEARTBEAT_SECONDS=30
CLIPFORGE_MAX_ATTEMPTS=3

# Scheduler lanes. The GPU lane MUST stay at 1 — see docs/PLAN.md §2.1.
CLIPFORGE_GPU_LANE_DEPTH=1
CLIPFORGE_CPU_LANE_DEPTH=3

# ─────────────────────────────────────────────────────────────────────────────
# Workspace — local media storage
# ─────────────────────────────────────────────────────────────────────────────
CLIPFORGE_WORKSPACE_DIR=./workspace
CLIPFORGE_WORKSPACE_MAX_GB=60

# Refuse a video longer than this, before downloading it. Four hours.
CLIPFORGE_MAX_SOURCE_DURATION_SEC=14400

# ─────────────────────────────────────────────────────────────────────────────
# Models
# ─────────────────────────────────────────────────────────────────────────────
CLIPFORGE_WHISPER_MODEL=large-v3-turbo
CLIPFORGE_WHISPER_COMPUTE_TYPE=int8_float16
CLIPFORGE_WHISPER_DEVICE=cuda

CLIPFORGE_OLLAMA_HOST=http://127.0.0.1:11434
CLIPFORGE_OLLAMA_MODEL=qwen3.5:4b
CLIPFORGE_OLLAMA_NUM_CTX=16384

# VRAM headroom reserved for the desktop/browser, in MiB. The ModelBroker refuses
# to load a model that would not fit in (total - reserve).
CLIPFORGE_VRAM_RESERVE_MB=700

# ─────────────────────────────────────────────────────────────────────────────
# Media / render
# ─────────────────────────────────────────────────────────────────────────────
CLIPFORGE_FFMPEG_BIN=ffmpeg
CLIPFORGE_FFPROBE_BIN=ffprobe
CLIPFORGE_RENDER_PROFILE=default
CLIPFORGE_VIDEO_ENCODER=h264_nvenc
CLIPFORGE_LOUDNESS_TARGET_LUFS=-14

# ─────────────────────────────────────────────────────────────────────────────
# Publishing (Phase 8) — OFF by default.
# Credentials live on the worker only and are NEVER written to Firestore.
# ─────────────────────────────────────────────────────────────────────────────
# Turning this on is meant to be a decision someone made after reading the rights
# guidance in the README — not a default anyone inherits.
CLIPFORGE_PUBLISHING_ENABLED=false

# The OAuth client JSON downloaded from the Google Cloud console, and where the
# resulting refresh token is kept. Both are paths on this machine.
# Set up with: clipforge-worker youtube-auth
# See docs/adr/0010-worker-held-publishing-credentials.md.
#
# Phase 9 added a third scope, yt-analytics.readonly, which the upload scope does
# not imply. A token authorised before that is refused by `poll-metrics` — by
# name, with the command to run — while publishing carries on working. Re-run
# youtube-auth once and both work.
CLIPFORGE_YOUTUBE_CLIENT_SECRETS=./.clipforge/youtube-client.json
CLIPFORGE_YOUTUBE_TOKEN_STORE=./.clipforge/youtube-token.enc

# Unlisted. Publishing to the world by accident is not recoverable the way an
# unlisted upload is: the link may already have been scraped.
CLIPFORGE_YOUTUBE_DEFAULT_PRIVACY=unlisted

# The loopback port the OAuth redirect lands on. Must match a redirect URI
# registered on the OAuth client.
CLIPFORGE_YOUTUBE_AUTH_PORT=8766

# ─────────────────────────────────────────────────────────────────────────────
# Local control API
# ─────────────────────────────────────────────────────────────────────────────
# A loopback-only, token-authenticated surface the desktop app uses to hand the
# worker a YouTube client secret. It is how the secret can be typed into a form
# and still never leave this machine — see docs/adr/0011-local-control-api.md.
#
# There is no host setting on purpose. It binds 127.0.0.1 and nothing else:
# unlike the file server, whose host is configurable because a port might clash,
# there is no version of exposing this one that is a supported mode.
CLIPFORGE_LOCAL_API_ENABLED=true
CLIPFORGE_LOCAL_API_PORT=8767
# In the home directory rather than the working directory: the worker and the
# desktop app start from different places, and a relative path would resolve
# to two different files that never pair up.
CLIPFORGE_LOCAL_API_TOKEN_FILE=~/.clipforge/local-api-token

# ─────────────────────────────────────────────────────────────────────────────
# The agent
# ─────────────────────────────────────────────────────────────────────────────
# A supervisor that starts with Windows, watches `agents/{workerId}` and starts
# or stops the worker when the PWA writes to it — so the worker can be started
# from a phone rather than only from this machine.
# See docs/adr/0012-machine-agent.md. Install it with:
#
#   powershell -File tools/agent.ps1 -Install -Live
#
# The two intervals are separate because they cost different things. The tick is
# local — it is what notices the worker dying, and nothing external will say so —
# and the heartbeat is a Firestore write plus a read.
CLIPFORGE_AGENT_TICK_SECONDS=2.0
CLIPFORGE_AGENT_HEARTBEAT_SECONDS=60

# How many of the worker's output lines travel with the report, so a start that
# fails says why on the phone that asked for it. Bounded: this document is
# written every heartbeat.
CLIPFORGE_AGENT_LOG_LINES=20

# How many times a worker that will not stay up is restarted before the agent
# stops trying and leaves the reason on screen. Pressing Start again clears it.
CLIPFORGE_AGENT_RESTART_LIMIT=5
CLIPFORGE_AGENT_RESTART_BACKOFF_SECONDS=15

# How long a clean stop is waited for before a worker the agent started is
# terminated. Matches the desktop shell, and both exist because the worker's own
# shutdown asks its stages to check-point first.
CLIPFORGE_AGENT_SHUTDOWN_GRACE_SECONDS=15

# Where the agent writes its own log. Task Scheduler gives it no console, so
# without a file a failure to start would be invisible — which is the one failure
# it most needs to be able to explain.
CLIPFORGE_AGENT_LOG_FILE=~/.clipforge/agent.log

# ─────────────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────────────
CLIPFORGE_LOG_LEVEL=INFO
CLIPFORGE_LOG_FORMAT=console
