# Normalise line endings in the repository regardless of each contributor's
# core.autocrlf setting. Without this, a Windows clone checks out CRLF, and
# `prettier --check` and `ruff format --check` then fail in CI for files that
# are byte-identical to the ones that passed on the author's machine.
* text=auto eol=lf

# PowerShell is the exception: Windows PowerShell 5.1 wants CRLF, and the
# UTF-8 BOM these files carry is content rather than a line ending, so it
# survives this normalisation. See CONTRIBUTING.md.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary: never touch, never diff.
*.png  binary
*.jpg  binary
*.ico  binary
*.mp4  binary
*.mkv  binary
*.webm binary
*.wav  binary
*.m4a  binary
*.woff  binary
*.woff2 binary

# Generated lockfiles: keep them out of diffs and out of language stats.
apps/web/package-lock.json  linguist-generated=true -diff
apps/worker/uv.lock         linguist-generated=true -diff
